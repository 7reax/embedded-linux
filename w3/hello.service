[Unit]
Description=Hello World Demo Prozess (/proc Demonstration)
Documentation=https://man7.org/linux/man-pages/man5/proc.5.html
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/embedded_linux
User=c4
WorkingDirectory=/tmp
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
